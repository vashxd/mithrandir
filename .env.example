APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Mithrandir -------------------------------------------------------------
APP_TIMEZONE=America/Sao_Paulo
MITHRANDIR_TZ=America/Sao_Paulo

# DJEN / Comunica (CNJ) - gratuito, sem chave. Gatilho formal de prazo.
DJEN_BASE_URL=https://comunicaapi.pje.jus.br
DJEN_ITENS_POR_PAGINA=100
DJEN_SYNC_MANUAL_MIN=10

# DataJud (CNJ) - enriquecimento do caso, nunca gatilho de prazo.
# A chave publica sai na wiki do CNJ e pode mudar sem aviso; da para
# sobrescrever em runtime pela tela de Configuracoes.
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=

# Web Push (VAPID). Gere com: php artisan mithrandir:vapid --escrever
VAPID_SUBJECT=mailto:contato@mithrandir.app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

PRAZO_BUFFER_PADRAO=3
UPLOAD_MAX_MB=20
DJEN_JANELA_DIAS=7
DJEN_JANELA_INICIAL_DIAS=30
DJEN_TETO_VARREDURA=300

# --- Producao (Render + Neon + R2) ------------------------------------------
# Referencia dos valores usados no deploy. Em producao estas variaveis sao
# definidas no painel do Render, nao neste arquivo. Ver DEPLOY.md.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://mithrandir.onrender.com
# LOG_CHANNEL=stderr
#
# Neon: cole a connection string completa (com ?sslmode=require) em DB_URL.
# DB_CONNECTION=pgsql
# DB_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/mithrandir?sslmode=require
# O pooler do Neon nao propaga erro de DDL em transacao: migrations vao pelo
# endpoint direto (mesma string, host SEM o sufixo -pooler).
# DB_MIGRATION_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/mithrandir?sslmode=require
# DB_SSLMODE=require
#
# O disco do Render free e efemero: documentos precisam ir para o B2.
# UPLOAD_DISK=s3
# FILESYSTEM_DISK=s3
# AWS_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AWS_DEFAULT_REGION=us-west-004
# AWS_USE_PATH_STYLE_ENDPOINT=false
#
# SESSION_SECURE_COOKIE=true
