# Modelo do arquivo de producao da VM. Copie para .env.producao no servidor e
# preencha. O .env.producao NAO vai para o repositorio (ver .gitignore).

APP_NAME=Mithrandir
APP_ENV=production
APP_DEBUG=false

# Dominio sem esquema - o Caddy usa para emitir o certificado Let's Encrypt.
APP_DOMINIO=mithrandir.exemplo.com.br
APP_URL=https://mithrandir.exemplo.com.br

APP_KEY=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
MITHRANDIR_TZ=America/Sao_Paulo

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Neon (Postgres) ----
DB_CONNECTION=pgsql
# Endpoint POOLED (host com -pooler): usado pelo app em runtime.
DB_URL=
# Endpoint DIRETO (host sem -pooler): usado so pelas migrations. O pooler nao
# propaga erro de DDL em transacao e a migration falha com SQLSTATE[25P02].
DB_MIGRATION_URL=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Backblaze B2 (documentos), via API S3 ----
UPLOAD_DISK=s3
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=mithrandir-documentos
AWS_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# No B2 a regiao e real, nao "auto": assinatura V4 com regiao errada devolve
# SignatureDoesNotMatch.
AWS_DEFAULT_REGION=us-east-005
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- Web push (gere com: php artisan mithrandir:vapid) ----
VAPID_SUBJECT=mailto:seu@email.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
