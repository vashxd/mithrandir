# Modelo para servidor proprio. Copie para .env.servidor e preencha.
# O .env.servidor NAO vai para o repositorio (ver .gitignore).

APP_NAME=Mithrandir
APP_ENV=production
APP_DEBUG=false

# Dominio sem esquema (usado pelo Caddy); APP_URL com https.
APP_DOMINIO=mithrandir.seudominio.com.br
APP_URL=https://mithrandir.seudominio.com.br

# Gere com: docker compose -f docker-compose.servidor.yml run --rm app \
#   php artisan key:generate --show
APP_KEY=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
MITHRANDIR_TZ=America/Sao_Paulo

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Postgres no proprio servidor ----
# As duas metades precisam bater: POSTGRES_* cria o banco no container,
# DB_* e como a aplicacao se conecta a ele.
POSTGRES_DB=mithrandir
POSTGRES_USER=mithrandir
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mithrandir
DB_USERNAME=mithrandir
DB_PASSWORD=TROQUE_ESTA_SENHA
# Banco na rede interna do compose, sem TLS: 'require' faria a conexao falhar.
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- Documentos no disco da maquina ----
# Gravados no volume 'documentos' (storage/app/private dentro do container).
UPLOAD_DISK=local
FILESYSTEM_DISK=local
UPLOAD_MAX_MB=20

# ---- Tunel da Cloudflare (so no profile "tunel") ----
# Token gerado no painel Zero Trust ao criar o tunel.
TUNNEL_TOKEN=

# ---- Web push (VAPID) ----
# Gere com: docker compose -f docker-compose.servidor.yml run --rm app \
#   php artisan mithrandir:vapid
VAPID_SUBJECT=mailto:seu@email.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
